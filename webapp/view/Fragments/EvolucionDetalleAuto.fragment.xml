<Dialog contentWidth="90%" id="detalleHistoricoAutoDialog" title="Detalle evolucion"
	xmlns="sap.m"
	xmlns:l="sap.ui.layout"
	xmlns:form="sap.ui.layout.form"
	xmlns:core="sap.ui.core"
	xmlns:u="sap.uxap">
	<u:ObjectPageLayout  enableLazyLoading="true" useIconTabBar="true" toggleHeaderOnTitleClick="false" headerContentPinnable="false">
		<u:headerTitle>
			<u:ObjectPageDynamicHeaderTitle>
				<u:expandedHeading>
					<Title text="{detalleHistoricoAutoModel>/Idauto} - {detalleHistoricoAutoModel>/Descripcion}" wrapping="true"/>
				</u:expandedHeading>
				<u:snappedHeading>
					<FlexBox fitContainer="true" alignItems="Center">
						<!--<Avatar class="sapUiTinyMarginEnd" src="sap-icon://technical-object" displaySize="XS" showBorder="true"/>-->
						<Title text="{detalleHistoricoAutoModel>/Idauto} - {detalleHistoricoAutoModel>/Descripcion}" wrapping="true"/>
					</FlexBox>
				</u:snappedHeading>
			</u:ObjectPageDynamicHeaderTitle>
		</u:headerTitle>
		<u:headerContent>
			<HBox wrap="Wrap" alignItems="Center" class="sapUiTinyMargin">
				<!--<Avatar class="sapUiSmallMarginEnd" src="sap-icon://technical-object" displaySize="L" showBorder="true"/>-->
				<VBox class="sapUiSmallMarginEnd customAvatar" justifyContent="Center" alignItems="Center">
					<core:Icon src="sap-icon://area-chart" size="2.25rem"/>
				</VBox>
			
				<HBox width="700px">
					<VBox class="sapUiMediumMarginEnd" width="80%">
						<ObjectAttribute class="sapUiTinyMarginBottom" title="{i18n>ed_emp}" text="{detalleHistoricoAutoModel>/Empresa}"/>
						<ObjectAttribute class="sapUiTinyMarginBottom" title="{i18n>ed_tipo_eq}" text="{detalleHistoricoAutoModel>/Elemento}"/>

					</VBox>

				</HBox>
			</HBox>
		</u:headerContent>
		<u:sections>
			<u:ObjectPageSection showTitle="false">
				<u:subSections>
					<u:ObjectPageSubSection>
						<HBox width="100%" wrap="Wrap">
							<VBox width="{= !${device>/system/phone} ? '50%' : 'auto' }">
								<form:Form editable="false" class="sapUiSmallMargin">
									<form:formContainers>
										<form:FormContainer>
											<form:formElements>
											
														<form:FormElement >
															<form:fields>
																<Input  value="{detalleHistoricoAutoModel>/Descripcion}" enabled="false"/>
															</form:fields>
															<form:label>
																<Label text="{i18n>ed_desc}"/>
															</form:label>
														</form:FormElement>
															<form:FormElement >
															<form:fields>
																<DatePicker  value="{path:'detalleHistoricoAutoModel>/FechaInicio', type: 'sap.ui.model.type.Date', formatOptions: {pattern: 'dd.MM.yyyy', UTC: true}}" enabled="false"/>
															</form:fields>
															<form:label>
																<Label text="{i18n>ed_inicioAct}"/>
															</form:label>
														</form:FormElement>
												<form:FormElement>
													<form:fields>
												<Input	value="{ path: 'detalleHistoricoAutoModel>/FechaFin', formatter: '.formatter.formatDateFromYYYYMMDD' }" enabled="false"/>
																<!-- <DatePicker  value="{path:'detalleHistoricoAutoModel>/FECHAFINACTIVIDAD', type: 'sap.ui.model.type.Date', formatOptions: {pattern: 'dd.MM.yyyy', UTC: true}}" enabled="false"/> -->
													</form:fields>
													<form:label>
														<Label text="{i18n>ed_finAct}"/>
													</form:label>
												</form:FormElement>

												<form:FormElement >
													<form:fields>
														<Input  value="{detalleHistoricoAutoModel>/IdBde}" enabled="false" />
													</form:fields>
													<form:label>
														<Label text="{i18n>ed_idBde}"/>
													</form:label>
												</form:FormElement>
													<form:FormElement >
													<form:fields>
														<Input  value="{detalleHistoricoAutoModel>/IdPagotran}" enabled="false" />
													</form:fields>
													<form:label>
														<Label text="{i18n>ed_idPagotran}"/>
													</form:label>
												</form:FormElement>
											
												
																			
											</form:formElements>
										</form:FormContainer>
									</form:formContainers>
									<form:layout>
										<form:ResponsiveGridLayout labelSpanXL="12" labelSpanL="12" labelSpanM="12" labelSpanS="12" adjustLabelSpan="false" emptySpanXL="0" emptySpanL="0" emptySpanM="0" emptySpanS="0" columnsXL="2" columnsL="2" columnsM="1" singleContainerFullSize="false"/>
									</form:layout>
								</form:Form>
							</VBox>
							<VBox width="{= !${device>/system/phone} ? '50%' : 'auto' }">
								<form:Form editable="false" class="sapUiSmallMargin">
									<form:formContainers>
										<form:FormContainer>
											<form:formElements>
					
												<form:FormElement>
													<form:fields>
														<Input maxLength="40" value="{detalleHistoricoAutoModel>/Nemo}" enabled="false"/>

													</form:fields>
													<form:label>
														<Label text="{i18n>ed_nemo}"/>
													</form:label>
												</form:FormElement>
												<form:FormElement>
															<form:fields>
																<Input maxLength="4" value="{detalleHistoricoAutoModel>/Elemento}" enabled="false"/>
															</form:fields>
															<form:label>
																<Label text="{i18n>ed_elemento}"/>
															</form:label>
														</form:FormElement>
															
																							
														
													
																				<form:FormElement>

															<form:fields>
																<HBox >
																	<VBox class="sapUiSmallMarginEnd">
																		<Label text="{i18n>ed_remuneracion}" labelFor="remSwitch"/>
																		<Switch  state="{detalleHistoricoAutoModel>/Remuneracion}" customTextOn="Si" customTextOff="No" type="AcceptReject" enabled="false"/>
																	</VBox>
																	<VBox class="sapUiSmallMarginEnd">
																		<Label text="{i18n>ed_penaliza}" labelFor="penSwitch"/>
																		<Switch  state="{detalleHistoricoAutoModel>/Penaliza}" customTextOn="Si" customTextOff="No" type="AcceptReject" enabled="false"/>
																	</VBox>
																	<VBox class="sapUiSmallMarginEnd">
																		<Label text="{i18n>ed_premio}" labelFor="premioSwitch"/>
																		<Switch  state="{detalleHistoricoAutoModel>/Flagperdidarem}" customTextOn="Si" customTextOff="No" type="AcceptReject" enabled="false"/>
																	</VBox>
																</HBox>
															</form:fields>
														</form:FormElement>

											</form:formElements>
										</form:FormContainer>
									</form:formContainers>
									<form:layout>
										<form:ResponsiveGridLayout labelSpanXL="12" labelSpanL="12" labelSpanM="12" labelSpanS="12" adjustLabelSpan="false" emptySpanXL="0" emptySpanL="0" emptySpanM="0" emptySpanS="0" columnsXL="2" columnsL="2" columnsM="1" singleContainerFullSize="false"/>
									</form:layout>
								</form:Form>
							</VBox>
						</HBox>
					</u:ObjectPageSubSection>
				</u:subSections>
			</u:ObjectPageSection>
		</u:sections>
	</u:ObjectPageLayout>
	<buttons>
		<Button text="Cerrar" press=".onCloseDetalleHistoricoAutoDialog"/>
	</buttons>

</Dialog>
