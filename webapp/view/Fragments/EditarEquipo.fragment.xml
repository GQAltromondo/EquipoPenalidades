<core:FragmentDefinition xmlns="sap.m"
	xmlns:l="sap.ui.layout"
	xmlns:form="sap.ui.layout.form"
	xmlns:core="sap.ui.core"
	xmlns:u="sap.uxap">
	<Dialog contentWidth="90%" title="{i18n>ed_title}" busyIndicatorDelay="0">
		<content>
			<u:ObjectPageLayout id="ObjectPageLayout" enableLazyLoading="true" useIconTabBar="true" toggleHeaderOnTitleClick="false" headerContentPinnable="false">
				<u:headerTitle>
					<u:ObjectPageDynamicHeaderTitle>
						<u:expandedHeading>
							<Title text="{editModel>/Codigoequipo} - {editModel>/Descripcion}" wrapping="true"/>
						</u:expandedHeading>
						<u:snappedHeading>
							<FlexBox fitContainer="true" alignItems="Center">
								<!--<Avatar class="sapUiTinyMarginEnd" src="sap-icon://technical-object" displaySize="XS" showBorder="true"/>-->
								<Title text="{editModel>/Codigoequipo} - {editModel>/Descripcion}" wrapping="true"/>
							</FlexBox>
						</u:snappedHeading>
					</u:ObjectPageDynamicHeaderTitle>
				</u:headerTitle>
				<u:headerContent>
					<HBox wrap="Wrap" alignItems="Center" class="sapUiTinyMargin">
						<!--<Avatar class="sapUiSmallMarginEnd" src="sap-icon://technical-object" displaySize="L" showBorder="true"/>-->
						<VBox class="sapUiSmallMarginEnd customAvatar" justifyContent="Center" alignItems="Center">
							<core:Icon src="sap-icon://technical-object" size="2.25rem"/>
						</VBox>
						<VBox class="sapUiMediumMarginEnd">
							<ObjectAttribute class="sapUiTinyMarginBottom" title="{i18n>ed_equipo_cam}" text="{editModel>/Nroequipocammesa} - {editModel>/Descequipocammesa}"/>
							<ObjectAttribute class="sapUiTinyMarginBottom" title="{i18n>ed_emp}" text="{editModel>/Empresa}"/>
							<ObjectAttribute class="sapUiTinyMarginBottom" title="{i18n>ed_tipo_eq}" text="{editModel>/PtoCon}"/>
							<!-- <ObjectAttribute class="sapUiTinyMarginBottom" title="{i18n>ed_desde}" text="{path:'editModel>/Desde', type: 'sap.ui.model.type.Date', formatOptions: {pattern: 'dd.MM.yyyy', UTC: true}}"/>
							<ObjectAttribute title="{i18n>ed_hasta}" text="{path:'editModel>/Hasta', type: 'sap.ui.model.type.Date', formatOptions: {pattern: 'dd.MM.yyyy', UTC: true}}"/> -->
						</VBox>

						<HBox width="700px" alignItems="Center" justifyContent="End">

							<VBox class="sapUiMediumMarginEnd" justifyContent="End">

								<Button visible="{evoModel>/enabled}" text="{= ${evoModel>/enabled} ? 'Evolución del Equipo' : 'No posee historial' }" type="Emphasized" press="onEvolucionEquipo" />
								<ObjectAttribute visible="{evoModel>/enabled}" class="sapUiTinyMarginBottom" title="{i18n>ed_ult_modif}" text="{path: 'editModel>/FechaMod', formatter: '.formatter.formatDateDDMMYYYY'}" />
							</VBox>
						</HBox>
					</HBox>
				</u:headerContent>
				<u:sections>
					<u:ObjectPageSection showTitle="false">
						<u:subSections>
							<u:ObjectPageSubSection>
								<HBox width="100%" wrap="Wrap">
									<VBox width="{= !${device>/system/phone} ? '50%' : 'auto' }">
										<form:Form editable="false" class="sapUiSmallMargin">
											<form:formContainers>
												<form:FormContainer>
													<form:formElements>

														<form:FormElement >
															<form:fields>
																<Input value="{editModel>/Descripcion}"/>
															</form:fields>
															<form:label>
																<Label text="{i18n>ed_desc}"/>
															</form:label>
														</form:FormElement>

														<form:FormElement >
															<form:fields>
																<DatePicker value="{path:'editModel>/Fechainicioactividad', type: 'sap.ui.model.type.Date', formatOptions: {pattern: 'dd.MM.yyyy', UTC: true}}"/>
															</form:fields>
															<form:label>
																<Label text="{i18n>ed_inicioAct}"/>
															</form:label>
														</form:FormElement>

														<form:FormElement >
															<form:fields>
																<DatePicker value="{path:'editModel>/Fechafinactividad', type: 'sap.ui.model.type.Date', formatOptions: {pattern: 'dd.MM.yyyy', UTC: true}}"/>
															</form:fields>
															<form:label>
																<Label text="{i18n>ed_finAct}"/>
															</form:label>
														</form:FormElement>
														<form:FormElement >
															<form:fields>
																<Input type="Number" value="{editModel>/IdBde}"/>
															</form:fields>
															<form:label>
																<Label text="{i18n>ed_idBde}"/>
															</form:label>
														</form:FormElement>
															<form:FormElement >
															<form:fields>
																<Input type="Number" value="{editModel>/IdPagoTran}"/>
															</form:fields>
															<form:label>
																<Label text="{i18n>ed_idPagotran}"/>
															</form:label>
														</form:FormElement>
														

														<form:FormElement visible="{path: 'editModel>/PtoCon', formatter: '.formatter.isTransformador'}">
															<form:fields>
																<Input type="Number" value="{editModel>/Potencia}"/>
															</form:fields>
															<form:label>
																<Label text="{i18n>ed_pot}"/>
															</form:label>
														</form:FormElement>
														<form:FormElement >
															<form:fields>
																<!--<Input maxLength="20" value="{editModel>/Tension}"/>-->
																<Select id="selectTension" forceSelection="false" selectedKey="{editModel>/Tension}" items="{Desplegables>/Tensiones}">
																	<core:Item key="{Desplegables>Clave}" text="{Desplegables>Descripcion}"/>
																</Select>
															</form:fields>
															<form:label>
																<Label text="{i18n>ed_ten}"/>
															</form:label>
														</form:FormElement>
														<form:FormElement visible="{path: 'editModel>/PtoCon', formatter: '.formatter.isLinea'}">
															<form:fields>
																<!--<Input maxLength="10" value="{editModel>/Clasepenalizacion}"/>-->
																<Select forceSelection="false" selectedKey="{editModel>/Clasepenalizacion}" items="{Desplegables>/ClasePenalizacion}">
																	<core:Item key="{Desplegables>Clave}" text="{Desplegables>Descripcion}"/>
																</Select>
															</form:fields>
															<form:label>
																<Label text="{i18n>ed_clase_pen}"/>
															</form:label>
														</form:FormElement>
														<form:FormElement visible="{path: 'editModel>/PtoCon', formatter: '.formatter.isLinea'}">
															<form:fields>
																<Input type="Number" value="{editModel>/Longitudlineas}"/>
															</form:fields>
															<form:label>
																<Label text="{i18n>ed_lon}"/>
															</form:label>
														</form:FormElement>
														<form:FormElement visible="{path: 'editModel>/PtoCon', formatter: '.formatter.isLinea'}">
															<form:fields>
																<Input type="Number" value="{editModel>/KMLineasNorte}"/>
															</form:fields>
															<form:label>
																<Label text="{i18n>ed_KmN}"/>
															</form:label>
														</form:FormElement>
														<form:FormElement visible="{path: 'editModel>/PtoCon', formatter: '.formatter.isLinea'}">
															<form:fields>
																<Input type="Number" value="{editModel>/KMLineasCentroEste}" visible="{= ${viewModel>/sociedad} === '100' }"/>
															</form:fields>
															<form:label>
																<Label text="{i18n>ed_KmCE}" visible="{= ${viewModel>/sociedad} === '100' }"/>
															</form:label>
														</form:FormElement>
														<form:FormElement visible="{path: 'editModel>/PtoCon', formatter: '.formatter.isLinea'}">
															<form:fields>
																<Input type="Number" value="{editModel>/KMLineasSur}"/>
															</form:fields>
															<form:label>
																<Label text="{i18n>ed_KmS}"/>
															</form:label>
														</form:FormElement>

													</form:formElements>
												</form:FormContainer>
											</form:formContainers>
											<form:layout>
												<form:ResponsiveGridLayout labelSpanXL="12" labelSpanL="12" labelSpanM="12" labelSpanS="12" adjustLabelSpan="false" emptySpanXL="0" emptySpanL="0" emptySpanM="0" emptySpanS="0" columnsXL="2" columnsL="2" columnsM="1" singleContainerFullSize="false"/>
											</form:layout>
										</form:Form>
									</VBox>
									<VBox width="{= !${device>/system/phone} ? '50%' : 'auto' }">
										<form:Form editable="false" class="sapUiSmallMargin">
											<form:formContainers>
												<form:FormContainer>
													<form:formElements>

														<!-- <form:FormElement>
															<form:fields>
																<Input maxLength="4" value="{editModel>/EmpresaInt}"/>
															</form:fields>
															<form:label>
																<Label text="{i18n>ed_reporte}"/>
															</form:label>
														</form:FormElement> -->
														<form:FormElement>
															<form:fields>
																<!--<Input maxLength="40" value="{editModel>/Nemo}"/>-->
																<Select id="selectNemo" forceSelection="false" selectedKey="{editModel>/Nemo}" items="{NemoSet>/}">
																	<core:Item key="{NemoSet>NemoId}" text="{NemoSet>Descripcion}"/>
																</Select>
															</form:fields>
															<form:label>
																<Label text="{i18n>ed_nemo}"/>
															</form:label>
														</form:FormElement>
														<form:FormElement>
															<form:fields>
																<ComboBox items="{Desplegables>/Elementos}" selectedKey="{editModel>/Elemento}">
																	<core:Item key="{Desplegables>Clave}" text="{Desplegables>Descripcion}" />
																</ComboBox>
															</form:fields>
															<form:label>
																<Label text="{i18n>ed_elemento}"/>
															</form:label>
														</form:FormElement>
														<form:FormElement>
															<form:fields>
																<Input maxLength="250" value="{editModel>/Observaciones}"/>
															</form:fields>
															<form:label>
																<Label text="{i18n>ed_observacion}"/>
															</form:label>
														</form:FormElement>
														<!-- <form:FormElement>
															<form:fields>
																<Input value="{editModel>/Cebe}"/>
															</form:fields>
															<form:label>
																<Label text="{i18n>ed_cebe}"/>
															</form:label>
														</form:FormElement>
																<form:FormElement>
															<form:fields>
																<Input value="{editModel>/Kostl}"/>
															</form:fields>
															<form:label>
																<Label text="{i18n>ed_ceco}"/>
															</form:label>
														</form:FormElement> -->
														<form:FormElement >
															<form:fields>
																<Input type="Number" value="{editModel>/Coefreduc}"/>
															</form:fields>
															<form:label>
																<Label text="{i18n>ed_CoefSup}"/>
															</form:label>
														</form:FormElement>
														<form:FormElement >
															<form:fields>
																<DatePicker value="{path:'editModel>/Hastacoeficiente', type: 'sap.ui.model.type.Date', formatOptions: {pattern: 'dd.MM.yyyy', UTC: true}}"/>
																<!-- <DatePicker value="{path:'editModel>/Fechafinactividad', type: 'sap.ui.model.type.Date', formatOptions: {pattern: 'dd.MM.yyyy', UTC: true}}"/> -->
															</form:fields>
															<form:label>
																<Label text="{i18n>ed_HastaCoefSup}"/>
															</form:label>
														</form:FormElement>
														<form:FormElement >
															<form:fields>
																<Input type="Number" value="{editModel>/Coeficiente}"/>
															</form:fields>
															<form:label>
																<Label text="{i18n>ed_CoefRem}"/>
															</form:label>
														</form:FormElement>
														<form:FormElement>
															<form:fields>
																<!--<Input maxLength="40" value="{editModel>/Regionpenalidades}"/>-->
																<MultiComboBox id="selectPenalidades" selectedKeys="{editModel>/RegionpenalidadesKeys}" items="{Desplegables>/RegionPenalidades}">
																	<core:ListItem key="{Desplegables>Clave}" text="{Desplegables>Descripcion}"/>
																</MultiComboBox>
															</form:fields>
															<form:label>
																<Label text="{i18n>ed_region}"/>
															</form:label>
														</form:FormElement>

														<form:FormElement>

															<form:fields>
																<HBox >
																	<VBox class="sapUiSmallMarginEnd">
																		<Label text="{i18n>ed_remuneracion}" labelFor="remSwitch"/>
																		<Switch id="remSwitch" state="{editModel>/Remuneracion}" customTextOn="Si" customTextOff="No" type="AcceptReject"/>
																	</VBox>
																	<VBox class="sapUiSmallMarginEnd">
																		<Label text="{i18n>ed_penaliza}" labelFor="penSwitch"/>
																		<Switch id="penSwitch" state="{editModel>/Penaliza}" customTextOn="Si" customTextOff="No" type="AcceptReject"/>
																	</VBox>
																	<VBox class="sapUiSmallMarginEnd">
																		<Label text="{i18n>ed_premio}" labelFor="premioSwitch"/>
																		<Switch id="premioSwitch" state="{editModel>/Flagperdidarem}" customTextOn="Si" customTextOff="No" type="AcceptReject"/>
																	</VBox>
																</HBox>
															</form:fields>
														</form:FormElement>
													</form:formElements>
												</form:FormContainer>
											</form:formContainers>
											<form:layout>
												<form:ResponsiveGridLayout labelSpanXL="12" labelSpanL="12" labelSpanM="12" labelSpanS="12" adjustLabelSpan="false" emptySpanXL="0" emptySpanL="0" emptySpanM="0" emptySpanS="0" columnsXL="2" columnsL="2" columnsM="1" singleContainerFullSize="false"/>
											</form:layout>
										</form:Form>
									</VBox>
								</HBox>
							</u:ObjectPageSubSection>
						</u:subSections>
					</u:ObjectPageSection>
				</u:sections>
			</u:ObjectPageLayout>
		</content>
		<buttons>
			<Button icon="sap-icon://decline" text="{i18n>ed_cancel}" press="onCancelarEditar"/>
			<Button icon="sap-icon://accept" type="Emphasized" text="{i18n>ed_guardar}" press="onGuardarEquipo"/>
		</buttons>
	</Dialog>
</core:FragmentDefinition>