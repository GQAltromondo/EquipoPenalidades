<Dialog contentWidth="90%" id="detalleHistoricoDialog" title="Detalle evolucion"
	xmlns="sap.m"
	xmlns:l="sap.ui.layout"
	xmlns:form="sap.ui.layout.form"
	xmlns:core="sap.ui.core"
	xmlns:u="sap.uxap">
	<u:ObjectPageLayout id="ObjPageDetalleEvolucion" enableLazyLoading="true" useIconTabBar="true" toggleHeaderOnTitleClick="false" headerContentPinnable="false">
		<u:headerTitle>
			<u:ObjectPageDynamicHeaderTitle>
				<u:expandedHeading>
					<Title text="{detalleHistoricoModel>/CODIGOEQUIPO} - {detalleHistoricoModel>/DESCRIPCION}" wrapping="true"/>
				</u:expandedHeading>
				<u:snappedHeading>
					<FlexBox fitContainer="true" alignItems="Center">
						<!--<Avatar class="sapUiTinyMarginEnd" src="sap-icon://technical-object" displaySize="XS" showBorder="true"/>-->
						<Title text="{detalleHistoricoModel>/CODIGOEQUIPO} - {detalleHistoricoModel>/DESCRIPCION}" wrapping="true"/>
					</FlexBox>
				</u:snappedHeading>
			</u:ObjectPageDynamicHeaderTitle>
		</u:headerTitle>
		<u:headerContent>
			<HBox wrap="Wrap" alignItems="Center" class="sapUiTinyMargin">
				<!--<Avatar class="sapUiSmallMarginEnd" src="sap-icon://technical-object" displaySize="L" showBorder="true"/>-->
				<VBox class="sapUiSmallMarginEnd customAvatar" justifyContent="Center" alignItems="Center">
					<core:Icon src="sap-icon://area-chart" size="2.25rem"/>
				</VBox>
				<VBox class="sapUiMediumMarginEnd">
					<ObjectAttribute class="sapUiTinyMarginBottom" title="{i18n>ed_equipo_cam}" text="{detalleHistoricoModel>/NROEQUIPOCAMMESA} - {detalleHistoricoModel>/DESCEQUIPOCAMMESA}"/>
					<ObjectAttribute class="sapUiTinyMarginBottom" title="{i18n>ed_desde}" text="{ path: 'detalleHistoricoModel>/DESDE', formatter: '.formatter.formatDateFromYYYYMMDD' }"/>
					<ObjectAttribute title="{i18n>ed_hasta}" text="{ path: 'detalleHistoricoModel>/HASTA', formatter: '.formatter.formatDateFromYYYYMMDD' }"/>
				</VBox>

				<HBox width="700px">
					<VBox class="sapUiMediumMarginEnd" width="80%">
						<ObjectAttribute class="sapUiTinyMarginBottom" title="{i18n>ed_emp}" text="{detalleHistoricoModel>/EMPRESA}"/>
						<ObjectAttribute class="sapUiTinyMarginBottom" title="{i18n>ed_tipo_eq}" text="{detalleHistoricoModel>/TIPOEQUIPO}"/>
						<ObjectAttribute title="{i18n>ed_conexion}" text="{detalleHistoricoModel>/PTO_CON}"/>
					</VBox>

				</HBox>
			</HBox>
		</u:headerContent>
		<u:sections>
			<u:ObjectPageSection showTitle="false">
				<u:subSections>
					<u:ObjectPageSubSection>
						<HBox width="100%" wrap="Wrap">
							<VBox width="{= !${device>/system/phone} ? '50%' : 'auto' }">
								<form:Form editable="false" class="sapUiSmallMargin">
									<form:formContainers>
										<form:FormContainer>
											<form:formElements>
											
														<form:FormElement >
															<form:fields>
																<Input  value="{detalleHistoricoModel>/DESCRIPCION}" enabled="false"/>
															</form:fields>
															<form:label>
																<Label text="{i18n>ed_desc}"/>
															</form:label>
														</form:FormElement>
															<form:FormElement >
															<form:fields>
																<DatePicker  value="{path:'detalleHistoricoModel>/FECHAINICIOACTIVIDAD', type: 'sap.ui.model.type.Date', formatOptions: {pattern: 'dd.MM.yyyy', UTC: true}}" enabled="false"/>
															</form:fields>
															<form:label>
																<Label text="{i18n>ed_inicioAct}"/>
															</form:label>
														</form:FormElement>
												<form:FormElement>
													<form:fields>
												<Input	value="{ path: 'detalleHistoricoModel>/FECHAFINACTIVIDAD', formatter: '.formatter.formatDateFromYYYYMMDD' }" enabled="false"/>
																<!-- <DatePicker  value="{path:'detalleHistoricoModel>/FECHAFINACTIVIDAD', type: 'sap.ui.model.type.Date', formatOptions: {pattern: 'dd.MM.yyyy', UTC: true}}" enabled="false"/> -->
													</form:fields>
													<form:label>
														<Label text="{i18n>ed_equipo}"/>
													</form:label>
												</form:FormElement>

												<form:FormElement >
													<form:fields>
														<Input  value="{detalleHistoricoModel>/ID_BDE}" enabled="false" />
													</form:fields>
													<form:label>
														<Label text="{i18n>ed_idBde}"/>
													</form:label>
												</form:FormElement>
												<form:FormElement>
													<form:fields>
														
														<Select forceSelection="false" selectedKey="{detalleHistoricoModel>/TENSION_DIR}" items="{Desplegables>/Tensiones}" enabled="false">
															<core:Item key="{Desplegables>Clave}" text="{Desplegables>Descripcion}"/>
														</Select>
													</form:fields>
													<form:label>
														<Label text="{i18n>ed_ten}"/>
													</form:label>
												</form:FormElement>
												<form:FormElement>
													<form:fields>
														<Select forceSelection="false" selectedKey="{detalleHistoricoModel>/CLASEPENALIZACION}" items="{Desplegables>/ClasePenalizacion}" enabled="false">
															<core:Item key="{Desplegables>Clave}" text="{Desplegables>Descripcion}"/>
														</Select>
													</form:fields>
													<form:label>
														<Label text="{i18n>ed_clase_pen}"/>
													</form:label>
												</form:FormElement>
											<form:FormElement  visible="{path: 'detalleHistoricoModel>/TIPOEQUIPO', formatter: '.formatter.isLinea'}">
													<form:fields>
														<Input  value="{detalleHistoricoModel>/LONGITUDLINEAS}" enabled="false"/>
													</form:fields>
													<form:label>
														<Label text="{i18n>ed_lon}"/>
													</form:label>
												</form:FormElement>
													<form:FormElement  visible="{path: 'detalleHistoricoModel>/TIPOEQUIPO', formatter: '.formatter.isLinea'}">
															<form:fields>
																<Input  value="{editModel>/KMLINEASNORTE}" enabled="false"/>
															</form:fields>
															<form:label>
																<Label text="{i18n>ed_KmN}"/>
															</form:label>
														</form:FormElement>
																<form:FormElement  visible="{path: 'detalleHistoricoModel>/TIPOEQUIPO', formatter: '.formatter.isLinea'}">
															<form:fields>
																<Input  value="{editModel>KMLINEASCENTROESTE}" enabled="false"/>
															</form:fields>
															<form:label>
																<Label text="{i18n>ed_KmCE}"/>
															</form:label>
														</form:FormElement>		
															<form:FormElement  visible="{path: 'detalleHistoricoModel>/TIPOEQUIPO', formatter: '.formatter.isLinea'}">
															<form:fields>
																<Input  value="{editModel>KMLINEASSUR}"/>
															</form:fields>
															<form:label>
																<Label text="{i18n>ed_KmS}"/>
															</form:label>
														</form:FormElement>
											</form:formElements>
										</form:FormContainer>
									</form:formContainers>
									<form:layout>
										<form:ResponsiveGridLayout labelSpanXL="12" labelSpanL="12" labelSpanM="12" labelSpanS="12" adjustLabelSpan="false" emptySpanXL="0" emptySpanL="0" emptySpanM="0" emptySpanS="0" columnsXL="2" columnsL="2" columnsM="1" singleContainerFullSize="false"/>
									</form:layout>
								</form:Form>
							</VBox>
							<VBox width="{= !${device>/system/phone} ? '50%' : 'auto' }">
								<form:Form editable="false" class="sapUiSmallMargin">
									<form:formContainers>
										<form:FormContainer>
											<form:formElements>
					
												<form:FormElement>
													<form:fields>
														<Input maxLength="40" value="{detalleHistoricoModel>/NEMO}" enabled="false"/>

													</form:fields>
													<form:label>
														<Label text="{i18n>ed_nemo}"/>
													</form:label>
												</form:FormElement>
												<form:FormElement>
															<form:fields>
																<Input maxLength="4" value="{detalleHistoricoModel>/ELEMENTO}" enabled="false"/>
															</form:fields>
															<form:label>
																<Label text="{i18n>ed_elemento}"/>
															</form:label>
														</form:FormElement>
															<form:FormElement>
															<form:fields>
																<Input maxLength="250" value="{detalleHistoricoModel>/OBSERVACIONES}" enabled="false"/>
															</form:fields>
															<form:label>
																<Label text="{i18n>ed_observacion}"/>
															</form:label>
														</form:FormElement>
																<form:FormElement>
															<form:fields>
																<Input  value="{detalleHistoricoModel>/CEBE}" enabled="false"/>
															</form:fields>
															<form:label>
																<Label text="{i18n>ed_cebe}"/>
															</form:label>
														</form:FormElement>
																<form:FormElement>
															<form:fields>
																<Input  value="{detalleHistoricoModel>/KOSTL}" enabled="false"/>
															</form:fields>
															<form:label>
																<Label text="{i18n>ed_ceco}"/>
															</form:label>
														</form:FormElement>
														
															<form:FormElement >
															<form:fields>
																<Input  value="{detalleHistoricoModel>/COEFICIENTE}" enabled="false"/>
															</form:fields>
															<form:label>
																<Label text="{i18n>ed_CoefSup}"/>
															</form:label>
														</form:FormElement>
															<form:FormElement>
													<form:fields>
													<Input	value="{ path: 'detalleHistoricoModel>/HASTACOEFICIENTE', formatter: '.formatter.formatDateFromYYYYMMDD' }" enabled="false"/>
																<!-- <DatePicker  value="{path:'detalleHistoricoModel>/HASTACOEFICIENTE', type: 'sap.ui.model.type.Date', formatOptions: {pattern: 'dd.MM.yyyy', UTC: true}}" enabled="false"/> -->
													</form:fields>
													<form:label>
														<Label text="{i18n>ed_HastaCoefSup}"/>
													</form:label>
												</form:FormElement>
														<form:FormElement >
															<form:fields>
																<Input  value="{detalleHistoricoModel>/COEFREDUC}" enabled="false"/>
															</form:fields>
															<form:label>
																<Label text="{i18n>ed_CoefRem}"/>
															</form:label>
														</form:FormElement>
												<form:FormElement>
													<form:fields>
														<!--<Input maxLength="40" value="{detalleHistoricoModel>/Regionpenalidades}"/>-->
														<Select forceSelection="false" selectedKey="{detalleHistoricoModel>/REGIONPENALIDADES}" items="{Desplegables>/RegionPenalidades}" enabled="false">
															<core:Item key="{Desplegables>Clave}" text="{Desplegables>Descripcion}"/>
														</Select>
													</form:fields>
													<form:label>
														<Label text="{i18n>ed_region}"/>
													</form:label>
												</form:FormElement>
											<form:FormElement>

															<form:fields>
																<HBox >
																	<VBox class="sapUiSmallMarginEnd">
																		<Label text="{i18n>ed_remuneracion}" labelFor="remSwitch"/>
																		<Switch  state="{detalleHistoricoModel>/REMUNERACION}" customTextOn="Si" customTextOff="No" type="AcceptReject" enabled="false"/>
																	</VBox>
																	<VBox class="sapUiSmallMarginEnd">
																		<Label text="{i18n>ed_penaliza}" labelFor="penSwitch"/>
																		<Switch  state="{detalleHistoricoModel>/PENALIZA}" customTextOn="Si" customTextOff="No" type="AcceptReject" enabled="false"/>
																	</VBox>
																	<VBox class="sapUiSmallMarginEnd">
																		<Label text="{i18n>ed_premio}" labelFor="premioSwitch"/>
																		<Switch  state="{detalleHistoricoModel>/FLAGPERDIDAREM}" customTextOn="Si" customTextOff="No" type="AcceptReject" enabled="false"/>
																	</VBox>
																</HBox>
															</form:fields>
														</form:FormElement>

											</form:formElements>
										</form:FormContainer>
									</form:formContainers>
									<form:layout>
										<form:ResponsiveGridLayout labelSpanXL="12" labelSpanL="12" labelSpanM="12" labelSpanS="12" adjustLabelSpan="false" emptySpanXL="0" emptySpanL="0" emptySpanM="0" emptySpanS="0" columnsXL="2" columnsL="2" columnsM="1" singleContainerFullSize="false"/>
									</form:layout>
								</form:Form>
							</VBox>
						</HBox>
					</u:ObjectPageSubSection>
				</u:subSections>
			</u:ObjectPageSection>
		</u:sections>
	</u:ObjectPageLayout>
	<buttons>
		<Button text="Cerrar" press=".onCloseDetalleHistoricoDialog"/>
	</buttons>

</Dialog>
