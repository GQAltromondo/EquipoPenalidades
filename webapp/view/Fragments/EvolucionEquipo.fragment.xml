<Dialog id="historicoDialog" title="Histórico del Equipo {editModel>/Codigoequipo} - {editModel>/Descripcion}"
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <VBox>
        <Table items="{historicoEquipoModel>/}">
            <!-- columnas -->
            <columns>
                <Column>
                    <Text text="Codigo" />
                </Column>
                <Column>
                    <Text text="Bde" />
                </Column>
                <Column>
                    <Text text="Pagotran" />
                </Column>
                <!-- <Column>
                    <Text text="Descripción" />
                </Column> -->

                <Column>
                    <Text text="Fecha desde" />
                </Column>
                <Column>
                    <Text text="Fecha hasta" />
                </Column>
                <Column>
                    <Text text="Fecha de E. Comercial" />
                </Column>
                <Column>
                    <Text text="Fecha de S. Comercial" />
                </Column>
                <Column>
                    <Text text="Premio" />
                </Column>
                  <Column>
                    <Text text="MVA (Potencia)" />
                </Column>
                  <Column>
                    <Text text="Observ." />
                </Column>
                  <Column>
                    <Text text="Coef Remu" />
                </Column>
                  <Column>
                    <Text text="Coef Superv" />
                </Column>
                    <Column>
                    <Text text="Hasta Superv." />
                </Column>
                <Column>
                    <Text text="" />
                </Column>
            </columns>
            <items>
                <ColumnListItem>
                    <cells>
                        <Text text="{historicoEquipoModel>CODIGOEQUIPO}" />
                        <Text text="{historicoEquipoModel>ID_BDE}" />
                        <Text text="{historicoEquipoModel>ID_PAGOTRAN}" />
                        <!-- <Text text="{historicoEquipoModel>DESCRIPCION}" /> -->
                        <Text text="{ path: 'historicoEquipoModel>DESDE', formatter: '.formatter.formatDateFromYYYYMMDD' }" />
                        <Text text="{ path: 'historicoEquipoModel>HASTA', formatter: '.formatter.formatDateFromYYYYMMDD' }" />
                        <Text text="{ path: 'historicoEquipoModel>FECHAINICIOACTIVIDAD', formatter: '.formatter.formatDateFromYYYYMMDD' }" />
                        <Text text="{ path: 'historicoEquipoModel>FECHAFINACTIVIDAD', formatter: '.formatter.formatDateFromYYYYMMDD' }" />
                        <Text text="{historicoEquipoModel>PREMIO}" />
                        <Text text="{historicoEquipoModel>POTENCIA}" />
                        <Text text="{historicoEquipoModel>OBSERVACIONES}" />
                        <Text text="{historicoEquipoModel>COEFREDUC}" />
                        <Text text="{historicoEquipoModel>COEFICIENTE}" />
                        <Text text="{historicoEquipoModel>HASTACOEFICIENTE}" />
                        
                        <!-- más celdas -->
                        <Button icon="sap-icon://search" tooltip="Ver detalles" press=".onVerDetalleHistorico" type="Emphasized"/>
                    </cells>
                </ColumnListItem>
            </items>
        </Table>
    </VBox>
    <beginButton>
        <Button text="Cerrar" press="onCloseHistoricoDialog"/>
    </beginButton>
</Dialog>
