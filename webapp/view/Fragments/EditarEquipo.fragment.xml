	<Dialog contentWidth="90%" title="{i18n>ed_title}" busyIndicatorDelay="0">
		<content>
			<u:ObjectPageLayout id="ObjectPageLayout" enableLazyLoading="true" useIconTabBar="true" toggleHeaderOnTitleClick="false" headerContentPinnable="false">
				<u:headerTitle>
					<u:ObjectPageDynamicHeaderTitle>
						<u:expandedHeading>
							<Title text="{editModel>/Codigoequipo} - {editModel>/Descripcion}" wrapping="true"/>
						</u:expandedHeading>
						<u:snappedHeading>
							<FlexBox fitContainer="true" alignItems="Center">
								<!--<Avatar class="sapUiTinyMarginEnd" src="sap-icon://technical-object" displaySize="XS" showBorder="true"/>-->
								<Title text="{editModel>/Codigoequipo} - {editModel>/Descripcion}" wrapping="true"/>
							</FlexBox>
						</u:snappedHeading>
					</u:ObjectPageDynamicHeaderTitle>
				</u:headerTitle>
				<u:headerContent>
					<HBox wrap="Wrap" alignItems="Center" class="sapUiTinyMargin">
						<!--<Avatar class="sapUiSmallMarginEnd" src="sap-icon://technical-object" displaySize="L" showBorder="true"/>-->
						<VBox class="sapUiSmallMarginEnd customAvatar" justifyContent="Center" alignItems="Center">
							<core:Icon src="sap-icon://technical-object" size="2.25rem"/>
						</VBox>
						<VBox class="sapUiMediumMarginEnd">
							<ObjectAttribute class="sapUiTinyMarginBottom" title="{i18n>ed_equipo_cam}" text="{editModel>/Nroequipocammesa} - {editModel>/Descequipocammesa}"/>
							<ObjectAttribute class="sapUiTinyMarginBottom" title="{i18n>ed_desde}" text="{path:'editModel>/Desde', type: 'sap.ui.model.type.Date', formatOptions: {pattern: 'dd.MM.yyyy', UTC: true}}"/>
							<ObjectAttribute title="{i18n>ed_hasta}" text="{path:'editModel>/Hasta', type: 'sap.ui.model.type.Date', formatOptions: {pattern: 'dd.MM.yyyy', UTC: true}}"/>
						</VBox>

						<HBox width="700px">
							<VBox class="sapUiMediumMarginEnd" width="80%">
							<ObjectAttribute class="sapUiTinyMarginBottom" title="{i18n>ed_emp}" text="{editModel>/Empresa}"/>
							<ObjectAttribute class="sapUiTinyMarginBottom" title="{i18n>ed_tipo_eq}" text="{editModel>/Tipoequipo}"/>
							<ObjectAttribute title="{i18n>ed_conexion}" text="{editModel>/PtoCon}"/>
						</VBox>
							<VBox class="sapUiMediumMarginEnd" justifyContent="End">
								<Button enabled="{evoModel>/enabled}" text="Evolucion del Equipo" type="Emphasized"  press="onEvolucionEquipo"/> 
							</VBox>
						</HBox>
					</HBox>
				</u:headerContent>
