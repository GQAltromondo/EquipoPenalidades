<mvc:View controllerName="Transener.Operaciones.EquiposPenalidades.controller.Equipos"
	xmlns:mvc="sap.ui.core.mvc" displayBlock="true"
	xmlns="sap.m"
	xmlns:core="sap.ui.core"
	xmlns:smartTable="sap.ui.comp.smarttable"
	xmlns:smartFilterBar="sap.ui.comp.smartfilterbar"
	xmlns:l="sap.ui.layout"
	xmlns:f="sap.f"
	xmlns:card="sap.f.cards"
	xmlns:table="sap.ui.table">
	<!--<Shell id="shell">-->
	<App id="app">
		<pages>
			<Page showHeader="false" id="page" title="{i18n>title}">
				<content>
					<l:Splitter orientation="Vertical" width="100%">
						<VBox>
							<!--Filter bar-->
							<Panel width="100%" expandable="true" expanded="true" backgroundDesign="Solid">
								<headerToolbar>
									<OverflowToolbar>
										<core:Icon src="sap-icon://filter"/>
										<Title text="{i18n>fb_title}"/>
									</OverflowToolbar>
								</headerToolbar>
								<content>
									<smartFilterBar:SmartFilterBar id="idSmartFilterBar" entitySet="EquiposPenalidadesSet" considerSelectionVariants="true" useToolbar="false" useDateRangeType="false" showClearOnFB="true" showClearButton="true" clear="onLimpiarFiltros">

										<smartFilterBar:controlConfiguration>

											<!-- 1) FechaDesde -->
											<smartFilterBar:ControlConfiguration key="FechaDesde" index="10" label="{i18n>fb_desde}" groupId="_BASIC">
												<smartFilterBar:customControl>
													<DateTimePicker displayFormat="dd.MM.yyyy HH:mm" valueFormat="yyyy-MM-dd'T'HH:mm:ss" placeholder="dd.mm.aaaa hh:mm" />
												</smartFilterBar:customControl>
											</smartFilterBar:ControlConfiguration>

											<!-- 2) FechaHasta -->
											<smartFilterBar:ControlConfiguration key="FechaHasta" index="20" label="{i18n>fb_hasta}" groupId="_BASIC">
												<smartFilterBar:customControl>
													<DateTimePicker displayFormat="dd.MM.yyyy HH:mm" valueFormat="yyyy-MM-dd'T'HH:mm:ss" placeholder="dd.mm.aaaa hh:mm" />
												</smartFilterBar:customControl>
											</smartFilterBar:ControlConfiguration>

											<!-- 3) IdBDE (custom, lo mapearás a contains sobre IdPagoTran) -->
											<smartFilterBar:ControlConfiguration key="IdBDE" index="30" label="Id BDE" groupId="_BASIC">
												<smartFilterBar:customControl>
													<Input placeholder="Buscar Id BDE..." />
												</smartFilterBar:customControl>
											</smartFilterBar:ControlConfiguration>

											<!-- 4) IdPagoTran (estándar) -->
											<smartFilterBar:ControlConfiguration key="IdPagoTran" index="40" label="Id Pago Tran" groupId="_BASIC"/>

											<!-- 5) Tipoequipo (MultiComboBox) -->
											<smartFilterBar:ControlConfiguration key="Tipoequipo" index="50" label="{i18n>fb_tipo_eq}" groupId="_BASIC" filterType="multiple" hasTypeAhead="false" controlType="dropDownList" visible="true">
												<smartFilterBar:customControl>
													<MultiComboBox items="{Desplegables>/TipoEquiposModel}">
														<core:Item key="{Desplegables>Tipo}" text="{Desplegables>Tipo} - {Desplegables>Descripcion}"/>
													</MultiComboBox>
												</smartFilterBar:customControl>
											</smartFilterBar:ControlConfiguration>

											<!-- 6) Nemo -->
											<smartFilterBar:ControlConfiguration key="Nemo" index="60" label="{i18n>fb_nemo}" groupId="_BASIC"/>

											<!-- 7) Regionpenalidades (MultiComboBox) -->
											<smartFilterBar:ControlConfiguration key="Regionpenalidades" index="70" label="{i18n>fb_reg}" groupId="_BASIC" filterType="multiple" hasTypeAhead="false" controlType="dropDownList" visible="true">
												<smartFilterBar:customControl>
													<MultiComboBox items="{Desplegables>/RegionPenalidades}">
														<core:Item key="{Desplegables>Clave}" text="{Desplegables>Descripcion}"/>
													</MultiComboBox>
												</smartFilterBar:customControl>
											</smartFilterBar:ControlConfiguration>

											<!-- 8) Remuneracion (Check) -->
											<smartFilterBar:ControlConfiguration key="Remuneracion" index="80" label="{i18n>fb_remuneracion}" groupId="_BASIC">
												<smartFilterBar:customControl>
													<CheckBox/>
												</smartFilterBar:customControl>
											</smartFilterBar:ControlConfiguration>

											<!-- 9) Penaliza (Check) -->
											<smartFilterBar:ControlConfiguration key="Penaliza" index="90" label="{i18n>fb_penaliza}" groupId="_BASIC">
												<smartFilterBar:customControl>
													<CheckBox/>
												</smartFilterBar:customControl>
											</smartFilterBar:ControlConfiguration>

											<!-- 10) Flagperdidarem (Check Premio) -->
											<smartFilterBar:ControlConfiguration key="Flagperdidarem" index="100" label="{i18n>fb_premio}" groupId="_BASIC">
												<smartFilterBar:customControl>
													<CheckBox/>
												</smartFilterBar:customControl>
											</smartFilterBar:ControlConfiguration>

											<!-- 11) Equipo (Codigoequipo) -->
											<smartFilterBar:ControlConfiguration key="Codigoequipo" index="110" label="{i18n>fb_cod_eq}" groupId="_BASIC"/>

											<!-- 12) Elemento (MultiComboBox: CON, LIN, TRA, REAC) -->
											<smartFilterBar:ControlConfiguration key="Elemento" index="120" label="Elemento" groupId="_BASIC" filterType="multiple" hasTypeAhead="false" controlType="dropDownList" visible="true">
												<smartFilterBar:customControl>
													<MultiComboBox items="{Desplegables>/Elementos}">
														<core:Item key="{Desplegables>Clave}" text="{Desplegables>Descripcion}" />
													</MultiComboBox>
												</smartFilterBar:customControl>
											</smartFilterBar:ControlConfiguration>

										</smartFilterBar:controlConfiguration>
									</smartFilterBar:SmartFilterBar>

								</content>
							</Panel>
							<IconTabBar id="idIconTabBar" class="sapUiTinyMargin" expandable="false">
								<items>
									<IconTabFilter text="Lineas" design="Horizontal" icon="sap-icon://line-charts" key="Lineas">
										<core:Fragment fragmentName="Transener.Operaciones.EquiposPenalidades.view.Fragments.TablaLineas" type="XML"/>
									</IconTabFilter>
									<IconTabFilter text="Transformadores" design="Horizontal" icon="sap-icon://machine" key="Transf">
										<core:Fragment fragmentName="Transener.Operaciones.EquiposPenalidades.view.Fragments.TablaTransformadores" type="XML" class="sapUiSmallMarginBottom"/>

									</IconTabFilter>
									<IconTabFilter text="Reactivo" design="Horizontal" icon="sap-icon://machine" key="React">

										<core:Fragment fragmentName="Transener.Operaciones.EquiposPenalidades.view.Fragments.TablaReactores" type="XML"/>
									</IconTabFilter>
									<IconTabFilter text="Conexion" design="Horizontal" icon="sap-icon://connected" key="Conexiones">
										<core:Fragment fragmentName="Transener.Operaciones.EquiposPenalidades.view.Fragments.TablaConexiones" type="XML"/>
									</IconTabFilter>
									<IconTabFilter text="Automatismos" design="Horizontal" icon="sap-icon://developer-settings" key="Automatismos" visible="{= ${viewModel>/sociedad} === '100' }">
										<core:Fragment fragmentName="Transener.Operaciones.EquiposPenalidades.view.Fragments.TablaAutomatismos" type="XML"/>
									</IconTabFilter>


								</items>
							</IconTabBar>



							<layoutData>
								<l:SplitterLayoutData size="auto" resizable="false"/>
							</layoutData>
						</VBox>
						<VBox id="boxDetalle" height="100%" backgroundDesign="Solid" width="100%">
							<VBox class="sapUiSmallMarginBeginEnd sapUiTinyMarginBottom cardDetalle" backgroundDesign="Solid">
								<OverflowToolbar width="100%">
									<!--<Avatar class="sapUiTinyMarginEnd" src="sap-icon://technical-object" displaySize="XS" showBorder="true"/>-->
									<Title level="H3" text="{Codigoequipo} - {Descripcion}"/>
									<ToolbarSpacer/>
									<Button icon="sap-icon://decline" press="onOcultarDetalle" type="Transparent"/>
								</OverflowToolbar>
								<HBox wrap="Wrap" alignItems="Center" class="sapUiTinyMargin">
									<VBox class="sapUiMediumMarginEnd">
										<ObjectAttribute class="sapUiTinyMarginBottom" title="{i18n>dt_circuito}" text="{Circuito}"/>
										<ObjectAttribute class="sapUiTinyMarginBottom" title="{i18n>dt_coef_red}" text="{Coefreduc}"/>
										<ObjectAttribute class="sapUiTinyMarginBottom" title="{i18n>dt_corredor}" text="{Corredor}"/>
										<ObjectAttribute class="sapUiTinyMarginBottom" title="{i18n>dt_extremoa}" text="{Extremoa}"/>
										<ObjectAttribute class="sapUiTinyMarginBottom" title="{i18n>dt_extremob}" text="{Extremob}"/>
										<ObjectAttribute title="{i18n>dt_extremos}" text="{Extremos}"/>
									</VBox>
									<VBox class="sapUiMediumMarginEnd">
										<ObjectAttribute class="sapUiTinyMarginBottom" title="{i18n>dt_fec_fin_act}" text="{path:'Fechafinactividad', type: 'sap.ui.model.type.Date', formatOptions: {pattern: 'dd.MM.yyyy', UTC: true}}"/>
										<ObjectAttribute class="sapUiTinyMarginBottom" title="{i18n>dt_fec_ini_act}" text="{path:'Fechainicioactividad', type: 'sap.ui.model.type.Date', formatOptions: {pattern: 'dd.MM.yyyy', UTC: true}}"/>
										<ObjectAttribute class="sapUiTinyMarginBottom" title="{i18n>dt_fec_servicio}" text="{path:'Fechafueraservicio', type: 'sap.ui.model.type.Date', formatOptions: {pattern: 'dd.MM.yyyy', UTC: true}}"/>
										<ObjectAttribute class="sapUiTinyMarginBottom" title="{i18n>dt_fecha_hora}" text="{path:'Fechahora', type: 'sap.ui.model.type.Date', formatOptions: {pattern: 'dd.MM.yyyy', UTC: true}}"/>
										<ObjectAttribute class="sapUiTinyMarginBottom" title="{i18n>dt_hora_fuera}" text="{path:'Horafueraservicio', type: 'sap.ui.model.type.Time', formatOptions: {pattern: 'HH:mm:ss'}}"/>
										<ObjectAttribute title="{i18n>dt_perten}" text="{Perteneciente}"/>
									</VBox>
									<VBox class="sapUiMediumMarginEnd">
										<ObjectAttribute class="sapUiTinyMarginBottom" title="{i18n>dt_flag_envio}" text="{Flagenvio}"/>
										<ObjectAttribute class="sapUiTinyMarginBottom" title="{i18n>dt_flag_pen}" text="{Flagpenalidades}"/>
										<ObjectAttribute class="sapUiTinyMarginBottom" title="{i18n>dt_flag_perdi}" text="{Flagperdidarem}"/>
										<ObjectAttribute class="sapUiTinyMarginBottom" title="{i18n>dt_grupo_aut}" text="{Tipoestacion}"/>
										<ObjectAttribute class="sapUiTinyMarginBottom" title="{i18n>dt_id}" text="{Id}"/>
										<ObjectAttribute title="{i18n>dt_nroserie}" text="{Nroserie}"/>
									</VBox>
									<VBox class="sapUiMediumMarginEnd">
										<ObjectAttribute class="sapUiTinyMarginBottom" title="{i18n>dt_penaliza}" text="{Penaliza}"/>
										<ObjectAttribute class="sapUiTinyMarginBottom" title="{i18n>dt_porc_pen}" text="{Porcpenalidades}"/>
										<ObjectAttribute class="sapUiTinyMarginBottom" title="{i18n>dt_porc_per}" text="{Porcperdidarem}"/>
										<ObjectAttribute class="sapUiTinyMarginBottom" title="{i18n>dt_reg_a}" text="{Extremoaregion}"/>
										<ObjectAttribute class="sapUiTinyMarginBottom" title="{i18n>dt_reg_b}" text="{Extremobregion}"/>
										<ObjectAttribute title="{i18n>dt_reg}" text="{Region}"/>
									</VBox>
									<VBox class="sapUiMediumMarginEnd">
										<ObjectAttribute class="sapUiTinyMarginBottom" title="{i18n>dt_registro}" text="{Registro}"/>
										<ObjectAttribute class="sapUiTinyMarginBottom" title="{i18n>dt_manio}" text="{Maniobrable}"/>
										<ObjectAttribute class="sapUiTinyMarginBottom" title="{i18n>dt_linea}" text="{Lineapartida}"/>
										<ObjectAttribute class="sapUiTinyMarginBottom" title="{i18n>dt_ubicacion}" text="{Ubicacion}"/>
										<ObjectAttribute class="sapUiTinyMarginBottom" title="{i18n>dt_usuario}" text="{Usuario}"/>
										<ObjectAttribute title="{i18n>dt_zona}" text="{Zona}"/>
									</VBox>
								</HBox>
							</VBox>
							<layoutData>
								<l:SplitterLayoutData size="{viewModel>/sizeDetail}"/>
							</layoutData>
						</VBox>
					</l:Splitter>
				</content>
				<footer>
					<Toolbar>
						<content>

							<ToolbarSpacer />
							<Text text="V{appCurrentInfo>/version}" />

						</content>
					</Toolbar>
				</footer>
			</Page>
		</pages>
	</App>
	<!--</Shell>-->
</mvc:View>